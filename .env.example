# Copy to .env for LOCAL development only. Never commit .env. In Azure, secrets come from Key Vault.
ENVIRONMENT=local
LOG_LEVEL=INFO

# Auth: local_dev (signed test tokens, local/test only) or entra
AUTH_MODE=local_dev
LOCAL_DEV_SIGNING_KEY=change-me-to-a-random-string-of-32-plus-chars

# Entra ID (required when AUTH_MODE=entra)
ENTRA_TENANT_ID=
ENTRA_AUDIENCE=
ENTRA_ISSUER=
ENTRA_JWKS_URL=

# Backing services
DATABASE_URL=postgresql+asyncpg://insurebot:insurebot@localhost:5432/insurebot
REDIS_URL=redis://localhost:6379/0
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# Azure only
KEY_VAULT_URL=
APPLICATIONINSIGHTS_CONNECTION_STRING=
